{
  "watch": ["server.js", "routes", "controllers", "services", "database", "middleware"],
  "ext": "js,mjs,json",
  "ignore": [
    "node_modules/**",
    ".cache/**",
    ".git/**",
    "*.log",
    "database/db.json",
    "package-lock.json"
  ],
  "delay": "1000",
  "legacyWatch": false,
  "verbose": false
}
